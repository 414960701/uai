{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uai-forge.local/schemas/plugin-package-manifest/2.0-proposed",
  "title": "UAI Forge Plugin Package Manifest v2 (proposed)",
  "description": "Proposed pre-import manifest. Presence of this schema does not mean the 0.1 loader implements it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "plugin_id",
    "plugin_version",
    "core_compatibility",
    "implementations"
  ],
  "properties": {
    "spec_version": {
      "const": "uai-forge.plugin-package/2.0"
    },
    "plugin_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
    },
    "plugin_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "core_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_inclusive",
        "max_exclusive"
      ],
      "properties": {
        "min_inclusive": {
          "type": "string",
          "minLength": 1
        },
        "max_exclusive": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "homepage": {
      "type": "string"
    },
    "implementations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/implementation"
      }
    }
  },
  "$defs": {
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "required",
        "rationale"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
        },
        "required": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "entry_point"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "entry_point": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_.]*$"
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "entry_point",
        "api_version",
        "protocol_version",
        "config_schema_version",
        "config_schema",
        "capabilities",
        "permissions",
        "trust_level",
        "failure_mode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "provider",
            "tool",
            "memory",
            "storage",
            "event_bus",
            "scheduler",
            "middleware",
            "ui",
            "workspace",
            "credential",
            "policy",
            "tracer"
          ]
        },
        "entry_point": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_.]*$"
        },
        "api_version": {
          "type": "string",
          "minLength": 1,
          "description": "Version of the implementation-facing UAI Forge plugin API."
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "config_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "config_schema": {
          "type": "object"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/permission"
          }
        },
        "trust_level": {
          "type": "string",
          "enum": [
            "core",
            "trusted_in_process",
            "isolated_process",
            "remote"
          ]
        },
        "failure_mode": {
          "type": "string",
          "enum": [
            "fail_closed",
            "fail_open_with_diagnostic"
          ]
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "migrations"
          ],
          "properties": {
            "schema_version": {
              "type": "string",
              "minLength": 1
            },
            "migrations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/migration"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "credential",
                  "policy"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "failure_mode": {
                "const": "fail_closed"
              }
            }
          }
        }
      ]
    }
  }
}
