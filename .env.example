# Copy to .env for Docker Compose or export the values in your shell.
# Never commit real provider keys or control-plane credentials.

# Container images and host ports
UAI_FORGE_FRONTEND_IMAGE=uai-forge-frontend:local
UAI_FORGE_BACKEND_IMAGE=uai-forge-backend:local
UAI_FORGE_WEB_PORT=3000
UAI_FORGE_API_PORT=8000
PYTHON_VERSION=3.11

# Local single-node control plane
UAI_FORGE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UAI_FORGE_SEED_DEMO=true
UAI_FORGE_DATA_VOLUME=uai-forge-data

# Optional shared API credential. Leave empty for local development.
UAI_FORGE_CONTROL_API_KEY=

# Provider credentials remain environment-only. Agent configuration stores the
# environment-variable name (for example OPENAI_API_KEY), never the value.
OPENAI_API_KEY=
