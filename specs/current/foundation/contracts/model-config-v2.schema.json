{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uai-forge.local/schemas/model-config/2.0",
  "title": "UAI Forge ModelConfig v2 public view",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "tenant_id", "name", "provider", "protocol", "model", "base_url", "masked_secret", "config", "metadata", "enabled", "version", "lifecycle", "verification", "created_at", "updated_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 2},
    "provider": {"type": "string", "minLength": 1},
    "protocol": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "base_url": {"type": ["string", "null"]},
    "masked_secret": {"type": "string"},
    "config": {"type": "object"},
    "metadata": {"type": "object"},
    "enabled": {"type": "boolean"},
    "version": {"type": "integer", "minimum": 1},
    "lifecycle": {"enum": ["draft", "verified", "enabled", "disabled", "error"]},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checked_at", "code", "latency_ms", "endpoint_summary"],
      "properties": {
        "status": {"enum": ["never", "passed", "failed"]},
        "checked_at": {"type": ["string", "null"], "format": "date-time"},
        "code": {"type": ["string", "null"]},
        "latency_ms": {"type": ["integer", "null"], "minimum": 0},
        "endpoint_summary": {"type": ["string", "null"]}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
